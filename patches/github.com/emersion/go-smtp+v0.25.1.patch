diff --git a/futurerelease_test.go b/futurerelease_test.go
new file mode 100644
index 0000000..62b5b71
--- /dev/null
+++ b/futurerelease_test.go
@@ -0,0 +1,123 @@
+package smtp_test
+
+import (
+	"io"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/emersion/go-smtp"
+)
+
+func TestServerFUTURERELEASE(t *testing.T) {
+	be, s, c, scanner, caps := testServerEhlo(t,
+		func(s *smtp.Server) {
+			s.EnableFUTURERELEASE = true
+			s.MaxFutureRelease = time.Hour
+		})
+	defer s.Close()
+	defer c.Close()
+
+	advertised := false
+	for capability := range caps {
+		if strings.HasPrefix(capability, "FUTURERELEASE 3600 ") {
+			advertised = true
+		}
+	}
+	if !advertised {
+		t.Fatal("Missing capability: FUTURERELEASE", caps)
+	}
+
+	malformed := []string{
+		"MAIL FROM:<root@nsa.gov> HOLDFOR=soon",
+		"MAIL FROM:<root@nsa.gov> HOLDUNTIL=tomorrow",
+		"MAIL FROM:<root@nsa.gov> HOLDFOR=7200",
+		"MAIL FROM:<root@nsa.gov> HOLDFOR=60 HOLDUNTIL=" + time.Now().Add(time.Minute).UTC().Format(time.RFC3339),
+	}
+	for _, msg := range malformed {
+		io.WriteString(c, msg+"\r\n")
+		scanner.Scan()
+		if !strings.HasPrefix(scanner.Text(), "501 5.5.4") {
+			t.Fatal("Unexpected response to", msg+":", scanner.Text())
+		}
+	}
+
+	io.WriteString(c, "MAIL FROM:<root@nsa.gov> HOLDFOR=60\r\n")
+	scanner.Scan()
+	if !strings.HasPrefix(scanner.Text(), "250 ") {
+		t.Fatal("Invalid HOLDFOR:", scanner.Text())
+	}
+	io.WriteString(c, "RCPT TO:<root@gchq.gov.uk>\r\n")
+	scanner.Scan()
+	io.WriteString(c, "DATA\r\n")
+	scanner.Scan()
+	io.WriteString(c, "Hey <3\r\n.\r\n")
+	scanner.Scan()
+	if !strings.HasPrefix(scanner.Text(), "250 ") {
+		t.Fatal("Invalid DATA response:", scanner.Text())
+	}
+	// Not signed in, so the test backend files it as anonymous.
+	if len(be.anonmsgs) != 1 {
+		t.Fatal("Invalid number of sent messages:", len(be.anonmsgs))
+	}
+	if until := be.anonmsgs[0].Opts.HoldUntil; time.Until(until) < 55*time.Second || time.Until(until) > time.Minute {
+		t.Fatal("Invalid HoldUntil:", until)
+	}
+}
+
+func TestServerFUTURERELEASEOff(t *testing.T) {
+	_, s, c, scanner, _ := testServerEhlo(t)
+	defer s.Close()
+	defer c.Close()
+
+	io.WriteString(c, "MAIL FROM:<root@nsa.gov> HOLDFOR=60\r\n")
+	scanner.Scan()
+	if !strings.HasPrefix(scanner.Text(), "504 5.5.4") {
+		t.Fatal("Unexpected response:", scanner.Text())
+	}
+}
+
+func TestClientFUTURERELEASE(t *testing.T) {
+	be, s, c, _ := testServer(t, func(s *smtp.Server) {
+		s.EnableFUTURERELEASE = true
+		s.MaxFutureRelease = time.Hour
+	})
+	defer s.Close()
+	client := smtp.NewClient(c)
+	defer client.Close()
+	if err := client.Hello("localhost"); err != nil {
+		t.Fatal(err)
+	}
+	if ok, limits := client.Extension("FUTURERELEASE"); !ok || !strings.HasPrefix(limits, "3600 ") {
+		t.Fatal("Missing capability: FUTURERELEASE", limits)
+	}
+	until := time.Now().Add(10 * time.Minute).Truncate(time.Second)
+	if err := client.Mail("root@nsa.gov", &smtp.MailOptions{HoldUntil: until}); err != nil {
+		t.Fatal("MAIL with HoldUntil:", err)
+	}
+	if err := client.Rcpt("root@gchq.gov.uk", nil); err != nil {
+		t.Fatal(err)
+	}
+	w, err := client.Data()
+	if err != nil {
+		t.Fatal(err)
+	}
+	io.WriteString(w, "Hey <3\r\n")
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if len(be.anonmsgs) != 1 || !be.anonmsgs[0].Opts.HoldUntil.Equal(until) {
+		t.Fatal("Invalid HoldUntil:", be.anonmsgs)
+	}
+}
+
+func TestClientFUTURERELEASEUnsupported(t *testing.T) {
+	_, s, c, _ := testServer(t)
+	defer s.Close()
+	client := smtp.NewClient(c)
+	defer client.Close()
+	err := client.Mail("root@nsa.gov", &smtp.MailOptions{HoldUntil: time.Now().Add(time.Minute)})
+	if err == nil || !strings.Contains(err.Error(), "FUTURERELEASE") {
+		t.Fatal("MAIL with HoldUntil to a server without FUTURERELEASE:", err)
+	}
+}
diff --git a/server.go b/server.go
index e0e0acd..05711f3 100644
--- a/server.go
+++ b/server.go
@@ -79,6 +79,16 @@ type Server struct {
 	// Default value of NONE to advertise no specific profile.
 	MtPriorityProfile PriorityProfile
 
+	// Advertise FUTURERELEASE (RFC 4865) capability, and accept the HOLDFOR
+	// and HOLDUNTIL arguments of MAIL as MailOptions.HoldUntil.
+	// Should be used only if backend supports it: the backend holds the
+	// message until then.
+	EnableFUTURERELEASE bool
+	// The longest a message may be held, advertised as seconds and as the
+	// latest release date. Required when FUTURERELEASE is enabled; a later
+	// release is refused.
+	MaxFutureRelease time.Duration
+
 	// The server backend.
 	Backend Backend
 
